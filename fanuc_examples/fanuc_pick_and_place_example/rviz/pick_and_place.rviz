        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        J1_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        J2_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
