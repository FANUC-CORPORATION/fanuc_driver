<package format="3">
  <name>fanuc_rmi_controller_example</name>
  <version>1.6.0</version>
  <description>
     An example package to use FanucRMIController.
  </description>

  <maintainer email="fanuc-ros-maintainer@fanuc.co.jp">FANUC CORPORATION</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>fanuc_crx_description</exec_depend>
  <exec_depend>fanuc_moveit_config</exec_depend>
  <exec_depend>fanuc_msgs</exec_depend>
  <exec_depend>rmi_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
